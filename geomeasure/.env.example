# GeoMeasure Environment Variables
# Copy this file to .env and set values for your environment.
# The application works with all defaults without a .env file.

# Override the SQLite database location (default: ./geomeasure.db relative to package root)
# DATABASE_URL=sqlite:///./geomeasure.db

# Override the upload directory (default: ./uploads relative to package root)
# UPLOAD_DIR=./uploads

# Maximum upload size in bytes (default: 52428800 = 50 MB)
# MAX_UPLOAD_SIZE_BYTES=52428800

# Number of decimal places for area display (default: 4)
# AREA_DISPLAY_DECIMALS=4

# Number of decimal places for length display (default: 4)
# LENGTH_DISPLAY_DECIMALS=4
